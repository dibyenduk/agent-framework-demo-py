# =============================================================================
# Agent Framework Demo — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your Foundry project.
#   cp .env.template .env
#
# Required fields are marked [REQUIRED]; everything else is per-notebook.
# =============================================================================

# ── Foundry Project (all notebooks) ──────────────────────────────────────────
# [REQUIRED] Your Foundry resource endpoint (used by Agent Framework)
# Format: https://<resource_name>.services.ai.azure.com
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com

# [REQUIRED] Full project endpoint (used by Foundry Project SDK in Notebook 01)
# Format: https://<resource_name>.ai.azure.com/api/projects/<project_name>
AZURE_AI_PROJECT_ENDPOINT_FULL=https://<your-resource>.ai.azure.com/api/projects/<your-project>

# [REQUIRED] Deployed model name (e.g. gpt-4.1, gpt-4o-mini, gpt-5-mini)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# ── Notebook 03 — MCP Server (optional) ─────────────────────────────────────
# URL of an MCP-compatible server (e.g. Microsoft Learn MCP)
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp

# ── Notebook 03 — FoundryAgent (service-managed agent) ──────────────────────
# If you have a pre-created Prompt Agent in Foundry portal, set its name here
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=

# ── Notebook 05 — Evaluation ─────────────────────────────────────────────────
# Full project URL for logging evaluation results to Foundry portal
# (same as AZURE_AI_PROJECT_ENDPOINT_FULL above — set once, used here too)
AZURE_AI_PROJECT=https://<your-resource>.ai.azure.com/api/projects/<your-project>
